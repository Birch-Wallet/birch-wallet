require "json"

default_platform(:ios)

DERIVED_DATA   = File.expand_path("../build/DerivedData", __dir__)
PRODUCTS_DIR   = "#{DERIVED_DATA}/Build/Products"
SCREENSHOT_SRC = File.expand_path("~/Library/Caches/tools.fastlane/screenshots")

# The xctestrun manifest produced by `build-for-testing`.
# Glob because the filename embeds the SDK version.
def xctestrun_path
  Dir.glob("#{PRODUCTS_DIR}/*.xctestrun").first ||
    UI.user_error!("No .xctestrun found — run the build step first")
end

# Device matrix: simulator name → the runtime it runs on. Each pass resolves
# the UDID for that exact name and runtime (creating the simulator if it's
# missing), because the same name exists on several runtimes and targeting by
# name can pick the wrong one.
DEVICES = {
  "iPhone 17 Pro Max"     => { runtime: "27.0" },
  "iPhone 17 Pro"         => { runtime: "27.0" },
  "iPhone 11 Pro Max"     => { runtime: "27.0" },
  "iPhone 13 mini"        => { runtime: "27.0" },
  "iPad Pro 13-inch (M5)" => { runtime: "27.0" },
  # The foldable. The iOS 27.1 runtime supports only this device. It is
  # captured closed (cover screen) and open (inner screen); the posture is set
  # with the `hinge` CLI because simctl has no fold command.
  "iPhone Duo"            => { runtime: "27.1", postures: ["closed", "open"] },
}

def runtime_identifier(runtime)
  "com.apple.CoreSimulator.SimRuntime.iOS-#{runtime.tr('.', '-')}"
end

def resolve_udid(name, runtime)
  runtime_id = runtime_identifier(runtime)
  devices = JSON.parse(`xcrun simctl list devices available -j`)["devices"][runtime_id] || []
  match = devices.find { |d| d["name"] == name }
  return match["udid"] if match

  type = JSON.parse(`xcrun simctl list devicetypes -j`)["devicetypes"].find { |t| t["name"] == name } ||
         UI.user_error!("No simulator device type named '#{name}'")
  UI.message("Creating '#{name}' on iOS #{runtime}")
  udid = `xcrun simctl create '#{name}' '#{type["identifier"]}' '#{runtime_id}'`.strip
  UI.user_error!("Could not create '#{name}' on iOS #{runtime}") if udid.empty?
  udid
end

# Folds or unfolds the Duo and confirms the angle. `hinge get` occasionally
# fails right after a state change, so retry a few times.
def set_posture(udid, posture)
  command, angle = posture == "open" ? ["open", 180.0] : ["close", 0.0]
  3.times do
    system("hinge", "-d", udid, command, out: File::NULL, err: File::NULL)
    sleep(2)
    return if `hinge -d #{udid} get 2>/dev/null`.strip.to_f == angle
  end
  UI.user_error!("Could not set the #{posture} posture on #{udid}")
end

# The open Duo's inner display: the largest built-in display simctl reports.
def inner_display(udid)
  ports = `xcrun simctl io #{udid} enumerate`.split(/^Port:/).map do |block|
    next unless block.include?("Display class: 0")
    uuid = block[/UUID: (\S+)/, 1]
    width = block[/Default width: (\d+)/, 1].to_i
    height = block[/Default height: (\d+)/, 1].to_i
    [uuid, width * height]
  end
  ports.compact.max_by(&:last)&.first || UI.user_error!("No built-in display found on #{udid}")
end

# Runs the tour while answering the capture requests SnapshotHelper makes when
# SNAPSHOT_HOST_CAPTURE is set: XCUIScreen can't see the open Duo's inner
# display, so each shot is taken here with `simctl io --display`. Requests
# land in the appearance subfolder the shot belongs to.
def run_tour_with_host_capture(command, udid, name)
  display = inner_display(udid)
  pid = Process.spawn({ "TEST_RUNNER_SNAPSHOT_HOST_CAPTURE" => "1" }, command)
  loop do
    Dir.glob("#{SCREENSHOT_SRC}/*/#{name}-*.request").each do |request|
      partial = request.sub(/\.request\z/, ".partial")
      system("xcrun", "simctl", "io", udid, "screenshot", "--type=png", "--display=#{display}", partial, out: File::NULL)
      File.rename(partial, request.sub(/\.request\z/, ".png")) if File.exist?(partial)
      File.delete(request)
    end
    break if Process.wait(pid, Process::WNOHANG)
    sleep(0.2)
  end
  $?.success?
end

APPEARANCES = ["dark", "light"].freeze

# Each pass's xcodebuild output and result bundle, kept out of the console
# because passes run side by side.
PASS_LOGS = File.expand_path("../build/screenshot-logs", __dir__)

# Seconds each pass's tour took, and whether it passed, for the summary.
PASS_TIMES = {}
PASS_TIMES_LOCK = Mutex.new

def report_pass_times(lane_started)
  rows = PASS_TIMES.map { |label, (seconds, passed)| [label, "#{seconds.round}s", passed ? "" : "FAILED"] }
  rows << ["Lane so far (build + tours)", "#{(Time.now - lane_started).round}s", ""]
  puts(Terminal::Table.new(title: "Tour times", rows: rows))
end

# Calls each job (a lambda) on up to `width` threads at once.
def run_concurrently(jobs, width)
  queue = Queue.new
  jobs.each { |job| queue << job }
  Array.new([width, jobs.size].min) do
    Thread.new do
      loop do
        job = begin
          queue.pop(true)
        rescue ThreadError
          break
        end
        job.call
      end
    end
  end.each(&:join)
end

# Frames every capture left in screenshots/<mode>/en-US with frameit, one
# frameit process per device and appearance, all at once. frameit frames one
# image at a time, and its action changes the process's working directory, so
# the work is split across processes rather than threads. Each process gets
# its own folder, and everything (bare and _framed) moves back afterwards.
def frame_in_parallel
  staging = File.expand_path("screenshots/_frameit", __dir__)
  FileUtils.rm_rf(staging)
  jobs = []
  APPEARANCES.each do |mode|
    src_dir = File.expand_path("screenshots/#{mode}/en-US", __dir__)
    Dir.glob("#{src_dir}/*.png").group_by { |f| File.basename(f)[/\A(.+?)-\d\d-/, 1] }.each do |device, files|
      dir = "#{staging}/#{mode}/#{device}"
      FileUtils.mkdir_p(dir)
      FileUtils.mv(files, dir)
      jobs << { dir: dir, back_to: src_dir, log: "#{PASS_LOGS}/frameit-#{mode}-#{device}.log" }
    end
  end

  UI.message("Framing #{jobs.size} device/appearance folders in parallel")
  FileUtils.mkdir_p(PASS_LOGS)
  pids = jobs.map do |job|
    Process.spawn(Gem.ruby, Gem.bin_path("fastlane", "fastlane"), "run", "frameit", "path:#{job[:dir]}", "use_platform:IOS",
                  out: job[:log], err: job[:log])
  end
  jobs.zip(pids).each do |job, pid|
    Process.wait(pid)
    UI.error("frameit failed for #{job[:dir]}. Log: #{job[:log]}") unless $?.success?
    FileUtils.mv(Dir.glob("#{job[:dir]}/*.png"), job[:back_to])
  end
  FileUtils.rm_rf(staging)
end

# Runs every device's tour, `parallel` simulators at a time. The Duo runs its
# two postures back to back on one simulator, so it starts first.
def run_screenshot_passes(devices, parallel)
  FileUtils.rm_rf(SCREENSHOT_SRC)
  FileUtils.mkdir_p(SCREENSHOT_SRC)
  FileUtils.mkdir_p(PASS_LOGS)

  queue = Queue.new
  devices.sort_by { |_, config| -(config[:postures] || [nil]).size }.each { |device| queue << device }
  workers = Array.new([parallel, devices.size].min) do
    Thread.new do
      loop do
        name, config = begin
          queue.pop(true)
        rescue ThreadError
          break
        end
        run_device_passes(name, config)
      end
    end
  end
  workers.each(&:join)
end

# One device: boot it, then run the tour once per posture (once for most
# devices) and collect that pass's dark and light captures.
def run_device_passes(name, config)
  udid = resolve_udid(name, config[:runtime])

  (config[:postures] || [nil]).each do |posture|
    label = posture ? "#{name} (#{posture.capitalize})" : name
    UI.message("▶ #{label}: starting")

    # Boot and wait until it's usable.
    system("xcrun", "simctl", "boot", udid, out: File::NULL, err: File::NULL)
    system("xcrun", "simctl", "bootstatus", udid, "-b", out: File::NULL)

    set_posture(udid, posture) if posture

    # A clean status bar: 9:41, full battery, full signal. The tour sets
    # the appearance itself for each capture.
    system("xcrun simctl status_bar #{udid} override " \
           "--time 09:41 --dataNetwork wifi --wifiMode active --wifiBars 3 " \
           "--cellularMode active --operatorName '' --cellularBars 4 " \
           "--batteryState charged --batteryLevel 100", out: File::NULL, err: File::NULL)

    # Clear this device's leftovers so passes don't mix (the Duo's two
    # postures share a simulator name).
    FileUtils.rm_f(Dir.glob("#{SCREENSHOT_SRC}/*/#{name}-*"))

    # Run the test with the explicit xctestrun manifest.
    # This installs all DependentProductPaths (including birch.app)
    # automatically — works around the Xcode 26 bug where
    # `xcodebuild build test` / `test-without-building -scheme` fail to
    # install the host app.
    log = "#{PASS_LOGS}/#{label}.log"
    result = "#{PASS_LOGS}/#{label}.xcresult"
    FileUtils.rm_rf(result)
    command = "xcodebuild test-without-building " \
              "-xctestrun '#{xctestrun_path}' " \
              "-destination 'id=#{udid}' " \
              "-only-testing:birchUITests/ScreenshotTests/testScreenshotTour " \
              "-parallel-testing-enabled NO " \
              "-resultBundlePath '#{result}' " \
              "> '#{log}' 2>&1"
    started = Time.now
    passed = if posture == "open"
               run_tour_with_host_capture(command, udid, name)
             else
               system(command)
             end
    seconds = Time.now - started
    PASS_TIMES_LOCK.synchronize { PASS_TIMES[label] = [seconds, passed] }
    if passed
      UI.success("✓ #{label}: tour took #{seconds.round}s")
    else
      UI.error("✗ #{label}: tour failed after #{seconds.round}s. Log: #{log}")
      File.foreach(log).grep(/error: -\[|failed \(/).first(5).each { |line| UI.error("  #{line.strip}") }
    end

    # Collect screenshots into the output directory. SnapshotHelper names
    # files after the simulator, so tag the Duo's with its posture.
    APPEARANCES.each do |mode|
      output_dir = File.expand_path("screenshots/#{mode}/en-US", __dir__)
      FileUtils.mkdir_p(output_dir)
      Dir.glob("#{SCREENSHOT_SRC}/#{mode}/#{name}-*.png").each do |src|
        dest = File.basename(src)
        dest = dest.sub(/\A#{Regexp.escape(name)}-/, "#{label}-") if posture
        FileUtils.cp(src, File.join(output_dir, dest))
      end
    end

    # Reset status bar and shut down
    system("xcrun", "simctl", "status_bar", udid, "clear", out: File::NULL, err: File::NULL)
    system("xcrun", "simctl", "shutdown", udid, out: File::NULL, err: File::NULL)
  end
end

platform :ios do
  desc "Capture App Store + marketing screenshots (dark and light in one tour per device)"
  #   fastlane screenshots                                   # every device
  #   fastlane screenshots only:"iPhone Duo"                 # rerun one device, keep the rest
  #   fastlane screenshots only:"iPhone 17 Pro,iPhone Duo"   # several devices
  #   fastlane screenshots frame:false                       # skip framing (quick iteration)
  #   fastlane screenshots parallel:1                        # one simulator at a time
  lane :screenshots do |options|
    devices = DEVICES
    only = options[:only].to_s.split(",").map(&:strip).reject(&:empty?)
    unless only.empty?
      unknown = only - DEVICES.keys
      UI.user_error!("Unknown device '#{unknown.join("', '")}'. Choose from: #{DEVICES.keys.join(', ')}") unless unknown.empty?
      devices = DEVICES.select { |name, _| only.include?(name) }
    end
    frame = options[:frame].to_s != "false"
    # Four at a time measured fastest (11.5 min vs 14.7 with three): the Duo's
    # two back-to-back passes become the longest chain.
    parallel = [(options[:parallel] || 4).to_i, 1].max
    lane_started = Time.now

    # ── 0. Clear previous output so stale files don't accumulate ────────
    if !only.empty?
      # Only these devices' captures, bare and framed.
      only.each do |name|
        Dir.glob(File.expand_path("screenshots/{dark,light}/**/#{name}*.png", __dir__)).each { |f| FileUtils.rm_f(f) }
      end
    else
      FileUtils.rm_rf(File.expand_path("screenshots/dark", __dir__))
      FileUtils.rm_rf(File.expand_path("screenshots/light", __dir__))
    end

    # The Duo passes fold the simulator with the `hinge` CLI.
    if devices.values.any? { |d| d[:postures] } && !system("which hinge", out: File::NULL)
      UI.user_error!("The iPhone Duo passes need `hinge`: brew install artemnovichkov/tap/hinge")
    end

    # Shut down any simulators left booted (e.g. from a manual test run) so the
    # per-device status-bar overrides in run_device_passes apply to
    # the right device. Belt-and-suspenders alongside targeting by UDID.
    sh("xcrun simctl shutdown all 2>/dev/null || true")

    # ── 1. Build for testing once ────────────────────────────────────────
    # Produces birch.app, birchUITests-Runner.app, and the
    # .xctestrun manifest that tells xcodebuild which apps to install.
    # `set -o pipefail` is essential: piping to xcpretty otherwise reports
    # xcpretty's exit status, so a failed build looks like a success and the
    # passes below silently screenshot whatever stale .app is already in
    # DERIVED_DATA. That produced two-month-old screenshots once.
    sh("set -o pipefail && xcodebuild build-for-testing " \
       "-scheme birch " \
       "-project ../birch.xcodeproj " \
       "-destination 'generic/platform=iOS Simulator' " \
       "-derivedDataPath '#{DERIVED_DATA}' " \
       "-parallel-testing-enabled NO " \
       "| xcpretty")

    # ── 2. One tour per device: SnapshotHelper captures every shot in dark
    #       and then light, so a single pass covers both appearances. Up to
    #       `parallel` devices run at once; the tour waits on the Electrum
    #       sync rather than sleeping, so a slower shared sync is fine ─────
    UI.header("Tours on #{devices.size} device(s), #{parallel} at a time")
    run_screenshot_passes(devices, parallel)

    report_pass_times(lane_started)
    next unless frame

    # ── 4. Prep captures for frameit ────────────────────────────────────
    # frameit gem 2.232.2 hardcodes its device list. scripts/patch-frameit.rb
    # extends it with iPhone 16/17 support (PR #29921), so iPhone 17 Pro and
    # Pro Max now go through frameit at their native resolution.
    #
    #   * iPhone 13 mini: frameit's bundled 13 Mini frame PNG has a ~3-pixel
    #     misalignment between the placement offset and the actual screen
    #     hole, leaving a visible gap on the right edge. Skip frameit for
    #     this device — step 7 composites it directly with ImageMagick,
    #     upscaling slightly so the screenshot fully covers the hole.
    thirteen_mini_holding = File.expand_path("screenshots/_13mini_bare", __dir__)
    FileUtils.rm_rf(thirteen_mini_holding)
    FileUtils.mkdir_p(thirteen_mini_holding)

    #   * iPad Pro 13" and iPhone Duo: frameit has no frame for either (its
    #     bundled iPad frames stop at 12.9"), and the App Store accepts bare
    #     screenshots. Move these captures out of frameit's path so it doesn't
    #     choke on an unknown device, then restore them bare in step 8.
    ipad_holding = File.expand_path("screenshots/_ipad_bare", __dir__)
    FileUtils.rm_rf(ipad_holding)
    FileUtils.mkdir_p(ipad_holding)

    ["dark", "light"].each do |mode|
      dir = File.expand_path("screenshots/#{mode}/en-US", __dir__)

      # Move 13 mini captures out of frameit's path; remember the mode.
      mode_holding = "#{thirteen_mini_holding}/#{mode}"
      FileUtils.mkdir_p(mode_holding)
      Dir.glob("#{dir}/iPhone 13 mini-*.png").each do |src|
        next if src.include?("_framed")
        FileUtils.mv(src, "#{mode_holding}/#{File.basename(src)}")
      end

      # Move iPad and Duo captures out of frameit's path; remember the mode.
      ipad_mode_holding = "#{ipad_holding}/#{mode}"
      FileUtils.mkdir_p(ipad_mode_holding)
      Dir.glob(["#{dir}/iPad*.png", "#{dir}/iPhone Duo*.png"]).each do |src|
        next if src.include?("_framed")
        FileUtils.mv(src, "#{ipad_mode_holding}/#{File.basename(src)}")
      end
    end

    # ── 5. Frame via frameit (17 Pro Max, 17 Pro, 11 Pro Max) ───────────
    frame_in_parallel

    # ── 6. Restore original names and separate framed into subfolder ───
    ["dark", "light"].each do |mode|
      src_dir    = File.expand_path("screenshots/#{mode}/en-US", __dir__)
      framed_dir = File.expand_path("screenshots/#{mode}/framed", __dir__)
      FileUtils.mkdir_p(framed_dir)

      # Move all _framed.png files into framed/.
      Dir.glob("#{src_dir}/*_framed.png").each do |f|
        FileUtils.mv(f, "#{framed_dir}/#{File.basename(f)}")
      end
    end

    # ── 7. Custom-frame iPhone 13 mini via ImageMagick ─────────────────
    # Composite each bare capture onto the 13 Mini bezel, upscaling slightly
    # (1080×2340 → 1086×2353) so the screenshot fully covers the bezel's
    # screen hole and no gap shows through on any edge.
    mini_frame = File.expand_path("~/.fastlane/frameit/latest/Apple iPhone 13 Mini Midnight.png")
    ["dark", "light"].each do |mode|
      src_dir    = File.expand_path("screenshots/#{mode}/en-US", __dir__)
      framed_dir = File.expand_path("screenshots/#{mode}/framed", __dir__)
      mode_holding = "#{thirteen_mini_holding}/#{mode}"

      composites = Dir.glob("#{mode_holding}/*.png").map do |src|
        base = File.basename(src, ".png")
        -> {
          system("magick", mini_frame, "(", src, "-resize", "1086x2353!", ")",
                 "-gravity", "center", "-composite", "#{framed_dir}/#{base}_framed.png") ||
            UI.error("Could not frame #{base}")
          # Restore bare capture to en-US/ for the normal bare output tree
          FileUtils.mv(src, "#{src_dir}/#{base}.png")
        }
      end
      run_concurrently(composites, 8)
    end
    FileUtils.rm_rf(thirteen_mini_holding)

    # ── 8. Restore iPad and Duo captures (bare — no frames available) ───
    # These go out unframed; just return the bare captures to en-US/ so they
    # land in the normal upload tree.
    ["dark", "light"].each do |mode|
      src_dir          = File.expand_path("screenshots/#{mode}/en-US", __dir__)
      ipad_mode_holding = "#{ipad_holding}/#{mode}"
      Dir.glob("#{ipad_mode_holding}/*.png").each do |src|
        FileUtils.mv(src, "#{src_dir}/#{File.basename(src)}")
      end
    end
    FileUtils.rm_rf(ipad_holding)
  end
end
