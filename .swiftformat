# SwiftFormat Configuration
# https://github.com/nicklockwood/SwiftFormat

# Swift Version (Required for formatting modern syntax like macros and SwiftData correctly)
--swiftversion 6.4

# The Xcode project builds in Swift 5 language mode (SWIFT_VERSION = 5.0)
--languagemode 5

# --- Indentation & Spacing ---
# 2 spaces for indentation
--indent 2

# Use Unix style line breaks
--linebreaks lf

# --- Exclusions ---
# Exclude auto-generated and package manager directories
--exclude **/Pods,**/.build,**/build,**/Package.swift,**/DerivedData
