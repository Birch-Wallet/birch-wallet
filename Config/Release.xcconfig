// Release.xcconfig — Release-specific build settings + reproducibility
#include "Base.xcconfig"

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
ENABLE_PREVIEWS = NO
MTL_ENABLE_DEBUG_INFO = NO
SWIFT_COMPILATION_MODE = wholemodule
VALIDATE_PRODUCT = YES

// Reproducibility: remap absolute paths in debug info
// Don't map $(HOME): the SDK's precompiled modules live under it, and
// dsymutil can't follow a "~/..." path to them when it builds the dSYM.
OTHER_SWIFT_FLAGS = $(inherited) -debug-prefix-map $(SRCROOT)=.
OTHER_CFLAGS = $(inherited) -fdebug-prefix-map=$(SRCROOT)=.
